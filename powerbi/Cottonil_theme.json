{
  "name": "Cottonil Intelligence",
  "dataColors": ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#6250D6", "#E34948"],
  "foreground": "#0B0B0B",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#898781",
  "background": "#FFFFFF",
  "backgroundLight": "#F8F9FB",
  "backgroundNeutral": "#E4E5E9",
  "tableAccent": "#0F1F4B",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#104281",
  "center": "#86B6EF",
  "minimum": "#CDE2FB",
  "null": "#C3C2B7",
  "hyperlink": "#2A78D6",
  "visitedHyperlink": "#256ABF",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0F1F4B" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514E" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E5E9" } }, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": true }],
        "title": [{ "show": true, "fontSize": 12, "fontColor": { "solid": { "color": "#0B0B0B" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F5F7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F5F7" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 24, "color": { "solid": { "color": "#0B0B0B" } } }],
        "categoryLabels": [{ "fontSize": 10, "color": { "solid": { "color": "#52514E" } } }],
        "accentBar": [{ "show": true, "color": { "solid": { "color": "#2A78D6" } }, "width": 3 }]
      }
    },
    "lineChart": { "*": { "lineStyles": [{ "strokeWidth": 2, "lineChartType": "smooth" }], "gridlines": [{ "gridlineColor": { "solid": { "color": "#EBEBE6" } } }] } },
    "slicer": { "*": { "items": [{ "fontSize": 10 }], "header": [{ "fontSize": 10, "fontColor": { "solid": { "color": "#52514E" } } }] } },
    "tableEx": { "*": { "columnHeaders": [{ "backColor": { "solid": { "color": "#F8F9FB" } }, "fontColor": { "solid": { "color": "#52514E" } } }], "grid": [{ "gridHorizontalColor": { "solid": { "color": "#E4E5E9" } } }] } }
  }
}
